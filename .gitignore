.DS_Store

# Python 字节码缓存：生成器/色板是当模块 import 的，跑一次就会留下
# __pycache__。它跟着 Python 版本走（.cpython-314.pyc），换机器/换版本就失效，
# 而且删掉主题后旧 .pyc 还会赖着，绝不该进仓库。
__pycache__/
*.py[cod]

# 用户自己导入的主题（./scripts/import.sh 生成）—— 跟 .zshrc.local 同性质，属个人状态不属产品。
# ⛔ 别跟踪：否则我本地测试导入的主题会跟着发版走进买家的包里；
#    连带它生成的 <主题>.json / ghostty/ warp/ ecosystem/ 也是一次性的。
config/themes/palettes/imported.py
# 上面两套导入主题（claude-code-light / rose-pine）的生成物与 imported.py 同性质，
# 也是一次性的个人状态，别跟踪；逐条显式列出，避免误伤品牌/社区主题。
config/themes/claude-code-light.json
config/themes/rose-pine.json
config/themes/ghostty/hekouwang-claude-code-light
config/themes/ghostty/hekouwang-claude-code-light-p3
config/themes/ghostty/hekouwang-rose-pine
config/themes/ghostty/hekouwang-rose-pine-p3
config/themes/warp/claude_code_light.yaml
config/themes/warp/rose_pine.yaml
config/themes/ecosystem/claude-code-light/
config/themes/ecosystem/rose-pine/
config/themes/ecosystem/vscode/themes/hekouwang-claude-code-light-color-theme.json
config/themes/ecosystem/vscode/themes/hekouwang-rose-pine-color-theme.json
tests/golden/claude-code-light.card.txt
tests/golden/rose-pine.card.txt

# 只在本机存在的工作目录，导出到子仓后仍要忽略。
# ⛔ 规则必须住在母版：导出会用本文件**覆盖**子仓的 .gitignore，
#    写在子仓里的一条会被下一次导出静默冲掉（2026-11-09 实测，launch/ 当场变待提交）。
launch/
.workbuddy/

# 本地计划与草稿：含付费边界、定价、删仓步骤等内部策略，不进公开仓。
# roadmap/ 自带独立 git 仓库（无远程），父仓库继续忽略，避免嵌套仓库告警。
roadmap/

# 渠道发布草稿与回执（materials/publish/channel/<渠道>/）：含编辑摘要、
# 引流策略与发布数据，属过程记录不属产品，不进公开仓。
# ⛔ 只能忽略 publish/，不能忽略整个 materials/：skillpay 营销图是公开素材，
#    已经被跟踪，忽略父目录会让后续新增图静默丢失。
materials/publish/

# 已归档的旧分档子仓（OSS / PRO）连同各自 .git 一起留档，不进母版历史。
archive/

# edition = Pro 增量本地仓；dist = 构建产物（均不进主仓 git）。
# public/ 仅防误建同名目录（旧 worktree 已废止，见 STRUCTURE）。
public/
edition/
dist/

# 每个服务一个独立私有仓；父仓库不跟踪，避免嵌套仓告警。
services/*/
!services/README.md

# Agent 本地配置（权限、会话设置），只存本机
.qwen/

# Playwright CLI 会话产物
.playwright-cli/

# T1 overlay：dev-overlay-from-edition.sh 叠回主仓的 Pro 路径（勿提交）
.hkw-edition-overlay
